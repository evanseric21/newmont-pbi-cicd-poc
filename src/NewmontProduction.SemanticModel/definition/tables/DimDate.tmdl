table DimDate

	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column MonthNumber
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, CatalogName),
				    Data = Source{[Schema = SchemaName, Item = "DimDate"]}[Data]
				in
				    Data

