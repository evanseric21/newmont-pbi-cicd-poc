model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SqlServer","CatalogName","SchemaName","DimSite","DimDate","FactProduction"]

ref table DimSite
ref table DimDate
ref table FactProduction

